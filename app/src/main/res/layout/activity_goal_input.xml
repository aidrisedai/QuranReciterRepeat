<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set Memorization Goal"
                android:textColor="@color/greeting_text"
                android:textSize="28sp"
                android:fontFamily="@font/outfit"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tell us what you want to memorize"
                android:textColor="@color/greeting_subtitle"
                android:textSize="15sp"
                android:layout_marginTop="4dp" />

            <!-- Goal Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:backgroundTint="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Goal"
                        android:textColor="@color/greeting_text"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit"
                        android:textStyle="bold" />

                    <!-- Text Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/goalInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="e.g., Memorize Surah Al-Mulk"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/goalInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences|textMultiLine"
                            android:maxLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Voice Input Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/voiceInputButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="🎤 Use Voice Input"
                        android:textColor="@color/md_theme_primary"
                        app:strokeColor="@color/md_theme_primary"
                        app:strokeWidth="1dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Strictness Level Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:backgroundTint="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Correction Level"
                        android:textColor="@color/greeting_text"
                        android:textSize="16sp"
                        android:fontFamily="@font/outfit"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How strictly should we check your recitation?"
                        android:textColor="@color/greeting_subtitle"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />

                    <RadioGroup
                        android:id="@+id/strictnessGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <RadioButton
                            android:id="@+id/strictnessLenient"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lenient - Focus on words, not Tajweed"
                            android:textColor="@color/greeting_text"
                            android:textSize="14sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp" />

                        <RadioButton
                            android:id="@+id/strictnessModerate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Moderate - Catch major mistakes"
                            android:textColor="@color/greeting_text"
                            android:textSize="14sp"
                            android:checked="true"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp" />

                        <RadioButton
                            android:id="@+id/strictnessStrict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Strict - Perfect Tajweed required"
                            android:textColor="@color/greeting_text"
                            android:textSize="14sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Examples Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                android:backgroundTint="@color/md_theme_primaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡 Example Goals"
                        android:textColor="@color/md_theme_onPrimaryContainer"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Memorize Surah Al-Mulk\n• 5 verses per day\n• Juz Amma\n• Surah 2 verses 1-20\n• Last 10 surahs"
                        android:textColor="@color/md_theme_onPrimaryContainer"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Parsed Goal Preview (initially hidden) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/parsedGoalCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:backgroundTint="@color/md_theme_tertiaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ Goal Understood"
                        android:textColor="@color/md_theme_onTertiaryContainer"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/parsedGoalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Surah 67 (Al-Mulk) • 30 verses"
                        android:textColor="@color/md_theme_onTertiaryContainer"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Cancel"
                    android:textColor="@color/greeting_text"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/createGoalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Create Goal"
                    android:enabled="false"
                    style="@style/Widget.MaterialComponents.Button" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
