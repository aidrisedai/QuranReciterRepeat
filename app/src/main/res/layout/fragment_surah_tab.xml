<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/surahSelectLayout"
style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        app:boxStrokeColor="@color/md_theme_primary"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxBackgroundColor="@color/md_theme_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Surah"
        app:endIconMode="dropdown_menu">
        <AutoCompleteTextView
            android:id="@+id/surahDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:inputType="textNoSuggestions"
            android:editable="false"
            android:focusable="true"
            android:clickable="true"/>
    </com.google.android.material.textfield.TextInputLayout>


    <!-- Playback controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:paddingHorizontal="16dp">

        <!-- Previous button (icon only) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevious"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:enabled="false"
            app:icon="@drawable/ic_skip_previous"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            app:iconPadding="0dp" />

        <!-- Play/Pause button (icon only) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayPause"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_play_arrow"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconPadding="0dp" />

        <!-- Stop button (icon only) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="#C15150"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconPadding="0dp"
            app:iconTint="@android:color/white" />

        <!-- Next button (icon only) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:enabled="false"
            app:icon="@drawable/ic_skip_next"
            app:iconGravity="textStart"
            app:iconSize="24dp"
            app:iconPadding="0dp" />
    </LinearLayout>

</LinearLayout>
