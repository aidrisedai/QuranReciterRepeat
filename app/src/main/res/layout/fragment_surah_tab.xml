<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/surahSelectLayout"
style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        app:boxStrokeColor="@color/md_theme_primary"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxBackgroundColor="@color/md_theme_surface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Surah"
        app:endIconMode="dropdown_menu">
        <AutoCompleteTextView
            android:id="@+id/surahDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:inputType="textNoSuggestions"
            android:editable="false"
            android:focusable="true"
            android:clickable="true"/>
    </com.google.android.material.textfield.TextInputLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:paddingHorizontal="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayPause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="16dp"
            app:icon="@drawable/ic_play_arrow"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="8dp"
android:backgroundTint="@color/md_theme_surface"
            android:textColor="@color/md_theme_primary"
            app:iconTint="@color/md_theme_primary"
            app:strokeColor="@color/md_theme_primary"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:paddingVertical="8dp"
            android:paddingHorizontal="16dp"
            android:text="STOP"
            android:textAllCaps="true"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            android:backgroundTint="#C15150" />
    </LinearLayout>

</LinearLayout>
