<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            style="@style/Widget.MaterialComponents.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:background="?attr/colorPrimary"
            app:title="@string/app_name"
            app:titleCentered="true"
            app:titleTextColor="@color/md_theme_onPrimary"
            app:navigationIconTint="@color/md_theme_onPrimary"
            app:popupTheme="@style/ThemeOverlay.RepeatQuran.Popup"
            app:menu="@menu/menu_main" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/modeTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabIndicatorColor="@color/md_theme_onPrimary"
            app:tabSelectedTextColor="@color/md_theme_onPrimary"
            app:tabTextColor="@color/md_theme_onPrimary"
            android:background="?attr/colorPrimary"/>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Global Pills: Repeat, Reciters, Speed in horizontal scrollable row -->
            <HorizontalScrollView
                android:id="@+id/globalPillsScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/globalPills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/repeatInlineLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:layout_width="105dp"
                        android:layout_height="wrap_content"
                        android:hint="Repeat"
                        app:hintTextAppearance="@style/TextAppearance.MaterialComponents.Caption">
                        <AutoCompleteTextView
                            android:id="@+id/repeatInlineDropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:inputType="textNoSuggestions"
                            android:editable="false"
                            android:focusable="true"
                            android:clickable="true"
                            android:importantForAutofill="no"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReciters"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Reciters: 1 selected"
                        android:textSize="13sp"
                        app:chipIconEnabled="false" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/speedInlineLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:hint="Speed"
                        app:hintTextAppearance="@style/TextAppearance.MaterialComponents.Caption">
                        <AutoCompleteTextView
                            android:id="@+id/speedInlineDropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:inputType="textNoSuggestions"
                            android:editable="false"
                            android:focusable="true"
                            android:clickable="true"
                            android:importantForAutofill="no" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ViewPager2 for tab content -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/modePager"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="400dp"
                app:layout_constraintTop_toBottomOf="@id/globalPillsScroll"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Divider -->
            <View
                android:id="@+id/dividerHistory"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/md_theme_outline"
                app:layout_constraintTop_toBottomOf="@id/modePager"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="16dp" />

            <!-- Recent Sessions -->
            <TextView
                android:id="@+id/historyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.RepeatQuran.Section"
                android:text="@string/title_recent_sessions"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/dividerHistory"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:id="@+id/historyContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/historyTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="6dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/md_theme_surface"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
