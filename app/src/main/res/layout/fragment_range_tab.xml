<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

<com.google.android.material.textfield.TextInputLayout
        android:id="@+id/startSurahLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
android:hint="Start Surah"
        app:endIconMode="dropdown_menu"
        app:boxStrokeColor="@color/md_theme_primary"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxBackgroundColor="@color/md_theme_surface">
        <AutoCompleteTextView
            android:id="@+id/startSurahDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:inputType="textNoSuggestions"
            android:editable="false"
            android:focusable="true"
            android:clickable="true"/>
    </com.google.android.material.textfield.TextInputLayout>

<com.google.android.material.textfield.TextInputLayout
        android:id="@+id/startAyahLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Start Ayah"
        app:endIconMode="dropdown_menu"
        app:boxStrokeColor="@color/md_theme_primary"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxBackgroundColor="@color/md_theme_surface"
        android:layout_marginTop="12dp">
        <AutoCompleteTextView
            android:id="@+id/startAyahDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:inputType="textNoSuggestions"
            android:editable="false"
            android:focusable="true"
            android:clickable="true"
            android:imeOptions="actionDone" />
    </com.google.android.material.textfield.TextInputLayout>

<com.google.android.material.textfield.TextInputLayout
        android:id="@+id/endSurahLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
android:hint="End Surah"
        app:endIconMode="dropdown_menu"
        app:boxStrokeColor="@color/md_theme_primary"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxBackgroundColor="@color/md_theme_surface"
        android:layout_marginTop="12dp">
        <AutoCompleteTextView
            android:id="@+id/endSurahDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:inputType="textNoSuggestions"
            android:editable="false"
            android:focusable="true"
            android:clickable="true"/>
    </com.google.android.material.textfield.TextInputLayout>

<com.google.android.material.textfield.TextInputLayout
        android:id="@+id/endAyahLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="End Ayah"
        app:endIconMode="dropdown_menu"
        app:boxStrokeColor="@color/md_theme_primary"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:boxBackgroundColor="@color/md_theme_surface"
        android:layout_marginTop="12dp">
        <AutoCompleteTextView
            android:id="@+id/endAyahDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:inputType="textNoSuggestions"
            android:editable="false"
            android:focusable="true"
            android:clickable="true"
            android:imeOptions="actionDone" />
    </com.google.android.material.textfield.TextInputLayout>


    <!-- Playback controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:paddingHorizontal="16dp">

        <!-- Play/Pause button (icon only) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayPause"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_play_arrow"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconPadding="0dp" />

        <!-- Stop button (icon only) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="0dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="#C15150"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconPadding="0dp"
            app:iconTint="@android:color/white" />
    </LinearLayout>

</LinearLayout>
